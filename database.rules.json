{
  "rules": {
    ".read": false,
    ".write": false,
    "status": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['state','last_changed'])",
        "state": {
          ".validate": "newData.val() === 'online' || newData.val() === 'offline'"
        },
        "last_changed": {
          ".validate": "newData.isNumber()"
        }
      }
    }
  }
}